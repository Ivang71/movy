# TMDB API key (v3 "API Key" or v4 "Read Access Token" both work).
# Without it the site renders from the bundled snapshot in src/data/fixtures.
TMDB_API_KEY=

# Optional image proxy prefix. Leave empty to load posters straight from image.tmdb.org.
# Example: https://wsrv.nl/?output=webp&q=70&url=
NEXT_PUBLIC_IMAGE_PROXY=

# Public site URL used for canonical / og:url tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
